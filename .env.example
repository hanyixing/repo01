# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored and is read by docker-compose / the deploy scripts.

# ---- Application ----
SERVER_PORT=8887

# ---- MySQL (production) ----
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=community
MYSQL_USERNAME=root
# MYSQL_HOST and MYSQL_PORT are provided by docker-compose (mysql:3306).
# Override them only when pointing at an external database.

# ---- GitHub OAuth ----
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8887/callback/github

# ---- Gitee OAuth ----
GITEE_CLIENT_ID=
GITEE_CLIENT_SECRET=
GITEE_REDIRECT_URI=http://localhost:8887/callback/gitee

# ---- UCloud UFile (file storage) ----
UCLOUD_BUCKET_NAME=
UCLOUD_BUCKET_TYPE=private
UCLOUD_EXPIRES_DURATION=315360000
UCLOUD_PUBLIC_KEY=
UCLOUD_PRIVATE_KEY=
UCLOUD_UPLOAD_DOMAIN=
UCLOUD_DOWNLOAD_DOMAIN=
